@model List<PoliclinicoWeb.Models.Cita>
@{
    ViewData["Title"] = "Mis Citas";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="fas fa-calendar-check"></i> Mis Citas Médicas</h4>
                <a href="/Cita/ReservarCita" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nueva Cita
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Doctor</th>
                                <th>Especialidad</th>
                                <th>Motivo</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model)
                            {
                                <tr>
                                    <td>@cita.FechaCita.ToString("dd/MM/yyyy")</td>
                                    <td>@cita.HoraCita.ToString(@"hh\:mm")</td>
                                    <td>Dr(a). @cita.NombreDoctor</td>
                                    <td>@cita.NombreEspecialidad</td>
                                    <td>@(cita.Motivo ?? "No especificado")</td>
                                    <td>
                                        @if (cita.Estado == "Pendiente")
                                        {
                                            <span class="badge bg-warning">Pendiente</span>
                                        }
                                        else if (cita.Estado == "Confirmada")
                                        {
                                            <span class="badge bg-success">Confirmada</span>
                                        }
                                        else if (cita.Estado == "Atendida")
                                        {
                                            <span class="badge bg-info">Atendida</span>
                                        }
                                        else if (cita.Estado == "Cancelada")
                                        {
                                            <span class="badge bg-danger">Cancelada</span>
                                        }
                                    </td>
                                    <td>
                                        @if (cita.Estado == "Pendiente" || cita.Estado == "Confirmada")
                                        {
                                            <button class="btn btn-sm btn-danger" onclick="cancelarCita(@cita.IdCita)">
                                                <i class="fas fa-times"></i> Cancelar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="icon-box warning mx-auto mb-3">
                        <i class="fas fa-calendar-times"></i>
                    </div>
                    <h5>No tienes citas programadas</h5>
                    <p class="text-muted">Reserva tu primera cita médica</p>
                    <a href="/Cita/ReservarCita" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Reservar Cita
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function cancelarCita(idCita) {
        Swal.fire({
            title: '¿Cancelar Cita?',
            text: 'Esta acción no se puede revertir',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, cancelar',
            cancelButtonText: 'No'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/Cita/CancelarCita?idCita=' + idCita, function(response) {
                    if (response.success) {
                        Swal.fire('Cancelada', response.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                });
            }
        });
    }
</script>
}
