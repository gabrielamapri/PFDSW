@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="icon-box danger mx-auto mb-4">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <h1 class="display-4 text-danger">Error</h1>
                    <p class="lead">Lo sentimos, ha ocurrido un error inesperado.</p>
                    <hr>
                    <p class="text-muted">
                        Si el problema persiste, por favor contacta al administrador del sistema.
                    </p>
                    <a href="/" class="btn btn-primary mt-3">
                        <i class="fas fa-home"></i> Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
