@{
    ViewData["Title"] = "Gestión de Horarios";
    var tipoUsuario = ViewBag.TipoUsuario as string;
    var isAdmin = tipoUsuario == "Admin";
    var isDoctor = tipoUsuario == "Doctor";
    var idDoctor = ViewBag.IdDoctor as int?;
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-clock me-2"></i>
                        @if (isAdmin)
                        {
                            <text>Gestión de Horarios de Doctores</text>
                        }
                        else
                        {
                            <text>Mis Horarios de Atención</text>
                        }
                    </h4>
                    <button type="button" class="btn btn-primary" onclick="mostrarModalNuevo()">
                        <i class="fas fa-plus me-1"></i>Nuevo Horario
                    </button>
                </div>
                <div class="card-body">
                    @if (isAdmin)
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Seleccionar Doctor:</label>
                                <select id="selectDoctor" class="form-select" onchange="cargarHorarios()">
                                    <option value="">-- Seleccione un doctor --</option>
                                </select>
                            </div>
                        </div>
                    }

                    <div class="table-responsive">
                        <table id="tablaHorarios" class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Día</th>
                                    <th>Hora Inicio</th>
                                    <th>Hora Fin</th>
                                    <th>Duración Cita (min)</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear/Editar Horario -->
<div class="modal fade" id="modalHorario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModal">Nuevo Horario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formHorario">
                    <input type="hidden" id="idHorario" />
                    <input type="hidden" id="idDoctor" value="@idDoctor" />

                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Doctor <span class="text-danger">*</span></label>
                            <select id="modalIdDoctor" class="form-select" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Día de la Semana <span class="text-danger">*</span></label>
                        <select id="diaSemana" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                            <option value="Lunes">Lunes</option>
                            <option value="Martes">Martes</option>
                            <option value="Miércoles">Miércoles</option>
                            <option value="Jueves">Jueves</option>
                            <option value="Viernes">Viernes</option>
                            <option value="Sábado">Sábado</option>
                            <option value="Domingo">Domingo</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Hora Inicio <span class="text-danger">*</span></label>
                            <input type="time" id="horaInicio" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Hora Fin <span class="text-danger">*</span></label>
                            <input type="time" id="horaFin" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Duración de cada Cita (minutos) <span class="text-danger">*</span></label>
                        <select id="duracionCita" class="form-select" required>
                            <option value="15">15 minutos</option>
                            <option value="20">20 minutos</option>
                            <option value="30" selected>30 minutos</option>
                            <option value="45">45 minutos</option>
                            <option value="60">60 minutos</option>
                        </select>
                    </div>

                    <div class="mb-3 form-check" id="divActivo" style="display:none;">
                        <input type="checkbox" class="form-check-input" id="activo" />
                        <label class="form-check-label" for="activo">Activo</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarHorario()">
                    <i class="fas fa-save me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let modalHorario;
    let tablaHorarios;
    let doctoresData = [];
    const isAdmin = @(isAdmin ? "true" : "false");
    const isDoctor = @(isDoctor ? "true" : "false");

    $(document).ready(function() {
        modalHorario = new bootstrap.Modal(document.getElementById('modalHorario'));
        
        tablaHorarios = $('#tablaHorarios').DataTable({
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
            },
            columns: [
                { data: 'diaSemana' },
                { 
                    data: 'horaInicio',
                    render: function(data) {
                        return formatearHora(data);
                    }
                },
                { 
                    data: 'horaFin',
                    render: function(data) {
                        return formatearHora(data);
                    }
                },
                { data: 'duracionCitaMinutos' },
                { 
                    data: 'activo',
                    render: function(data) {
                        return data ? '<span class="badge bg-success">Activo</span>' : '<span class="badge bg-danger">Inactivo</span>';
                    }
                },
                {
                    data: null,
                    render: function(data, type, row) {
                        let html = `<button class="btn btn-sm btn-warning me-1" onclick="editarHorario(${row.idHorario})">
                                        <i class="fas fa-edit"></i>
                                    </button>`;
                        
                        if (row.activo) {
                            html += `<button class="btn btn-sm btn-secondary me-1" onclick="cambiarEstado(${row.idHorario}, false)">
                                        <i class="fas fa-ban"></i>
                                     </button>`;
                        } else {
                            html += `<button class="btn btn-sm btn-success me-1" onclick="cambiarEstado(${row.idHorario}, true)">
                                        <i class="fas fa-check"></i>
                                     </button>`;
                        }
                        
                        html += `<button class="btn btn-sm btn-danger" onclick="eliminarHorario(${row.idHorario})">
                                    <i class="fas fa-trash"></i>
                                 </button>`;
                        return html;
                    }
                }
            ]
        });

        // Cargar doctores si es admin
        if (isAdmin) {
            cargarDoctores();
        } else if (isDoctor) {
            cargarHorarios();
        }
    });

    function cargarDoctores() {
        $.get('/Horario/ObtenerDoctores', function(data) {
            doctoresData = data;
            const selectDoctor = $('#selectDoctor');
            const modalSelectDoctor = $('#modalIdDoctor');
            
            selectDoctor.empty().append('<option value="">-- Seleccione un doctor --</option>');
            modalSelectDoctor.empty().append('<option value="">-- Seleccione --</option>');
            
            data.forEach(doctor => {
                const optionText = `${doctor.nombres} ${doctor.apellidos} - ${doctor.nombreEspecialidad}`;
                const optionTextModal = `${doctor.nombres} ${doctor.apellidos}`;
                selectDoctor.append(`<option value="${doctor.idDoctor}">${optionText}</option>`);
                modalSelectDoctor.append(`<option value="${doctor.idDoctor}">${optionTextModal}</option>`);
            });
        });
    }

    function cargarHorarios() {
        let idDoctor;
        
        if (isAdmin) {
            idDoctor = $('#selectDoctor').val();
            if (!idDoctor) {
                tablaHorarios.clear().draw();
                return;
            }
            $('#idDoctor').val(idDoctor);
            $('#modalIdDoctor').val(idDoctor);
        } else {
            idDoctor = $('#idDoctor').val();
        }

        $.get(`/Horario/ListarPorDoctor?idDoctor=${idDoctor}`, function(response) {
            tablaHorarios.clear();
            tablaHorarios.rows.add(response.data);
            tablaHorarios.draw();
        });
    }

    function mostrarModalNuevo() {
        if (isAdmin && !$('#selectDoctor').val()) {
            Swal.fire('Error', 'Debe seleccionar un doctor primero', 'error');
            return;
        }

        $('#tituloModal').text('Nuevo Horario');
        $('#formHorario')[0].reset();
        $('#idHorario').val('');
        $('#divActivo').hide();
        
        if (isAdmin) {
            $('#modalIdDoctor').val($('#selectDoctor').val());
        }
        
        modalHorario.show();
    }

    function editarHorario(idHorario) {
        const horario = tablaHorarios.data().toArray().find(h => h.idHorario === idHorario);
        
        $('#tituloModal').text('Editar Horario');
        $('#idHorario').val(horario.idHorario);
        $('#diaSemana').val(horario.diaSemana);
        $('#horaInicio').val(horario.horaInicio);
        $('#horaFin').val(horario.horaFin);
        $('#duracionCita').val(horario.duracionCitaMinutos);
        $('#activo').prop('checked', horario.activo);
        $('#divActivo').show();
        
        if (isAdmin) {
            $('#modalIdDoctor').val(horario.idDoctor);
        }
        
        modalHorario.show();
    }

    function guardarHorario() {
        if (!$('#formHorario')[0].checkValidity()) {
            $('#formHorario')[0].reportValidity();
            return;
        }

        const idHorario = $('#idHorario').val();
        const esEdicion = idHorario !== '';
        
        // Obtener idDoctor según el tipo de usuario
        let idDoctorValue;
        if (isAdmin) {
            idDoctorValue = $('#modalIdDoctor').val();
            if (!idDoctorValue || idDoctorValue === '') {
                Swal.fire('Error', 'Debe seleccionar un doctor', 'error');
                return;
            }
        } else {
            idDoctorValue = $('#idDoctor').val();
        }
        
        const horario = {
            idHorario: esEdicion ? parseInt(idHorario) : 0,
            idDoctor: parseInt(idDoctorValue),
            diaSemana: $('#diaSemana').val(),
            horaInicio: $('#horaInicio').val(),
            horaFin: $('#horaFin').val(),
            duracionCitaMinutos: parseInt($('#duracionCita').val()),
            activo: esEdicion ? $('#activo').prop('checked') : true
        };

        const url = esEdicion ? '/Horario/Actualizar' : '/Horario/Crear';

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(horario),
            success: function(response) {
                if (response.success) {
                    Swal.fire('Éxito', response.message, 'success');
                    modalHorario.hide();
                    cargarHorarios();
                } else {
                    Swal.fire('Error', response.message, 'error');
                }
            },
            error: function(xhr) {
                const errorMsg = xhr.responseJSON?.message || 'Ocurrió un error al guardar el horario';
                Swal.fire('Error', errorMsg, 'error');
            }
        });
    }

    function cambiarEstado(idHorario, activo) {
        const mensaje = activo ? 'activar' : 'desactivar';
        
        Swal.fire({
            title: '¿Está seguro?',
            text: `¿Desea ${mensaje} este horario?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sí, continuar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post(`/Horario/CambiarEstado?idHorario=${idHorario}&activo=${activo}`, function(response) {
                    if (response.success) {
                        Swal.fire('Éxito', response.message, 'success');
                        cargarHorarios();
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                });
            }
        });
    }

    function eliminarHorario(idHorario) {
        Swal.fire({
            title: '¿Está seguro?',
            text: 'Esta acción no se puede deshacer',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post(`/Horario/Eliminar?idHorario=${idHorario}`, function(response) {
                    if (response.success) {
                        Swal.fire('Éxito', response.message, 'success');
                        cargarHorarios();
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                });
            }
        });
    }

    function formatearHora(timeString) {
        if (!timeString) return '';
        // TimeString viene como "08:00:00" o "08:00"
        const parts = timeString.split(':');
        return `${parts[0]}:${parts[1]}`;
    }
</script>
}
